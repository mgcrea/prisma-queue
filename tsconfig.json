  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "src/*": ["./src/*"],
      "test/*": ["./test/*"],
    },
  },
  "include": ["src", "test", "*.config.ts"],
}
